generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  PARTICIPANT
  SUBJECT_MATTER_OWNER
  ADMINISTRATOR
  APPEAL_HANDLER
  REPORT_READER
  REVIEWER
}

enum SubmissionStatus {
  SUBMITTED
  PROCESSING
  SCORED
  UNDER_REVIEW
  COMPLETED
  // #951: forsoeket ble forlatt da deltakeren leverte paa nytt mens saken laa hos sensor.
  //
  // Et forlatt forsoek er IKKE et utfall. Det ble aldri avgjort av et menneske, og det skal
  // derfor verken telle som bestaatt eller stroeket — samme prinsipp som #948 slo fast for saker
  // som venter paa sensor.
  //
  // Foer denne statusen ble slike innleveringer satt til COMPLETED, og rapportene talte det gamle
  // AUTOMATISKE vedtaket som et endelig resultat. Sa vedtaket "bestaatt", ble forsoeket talt som
  // bestaatt i bestaatt-raten, mens CertificationStatus aldri ble skrevet — to kilder som sa
  // hver sin ting om samme deltaker.
  SUPERSEDED
  REJECTED
}

enum AppealStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
  SUPERSEDED
}

enum ReviewStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  SUPERSEDED
}

enum DecisionType {
  AUTOMATIC
  MANUAL_OVERRIDE
  APPEAL_RESOLUTION
}

enum AssessmentJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum DeletionTrigger {
  USER_REQUEST
  OFFBOARDING
  INACTIVITY
}

model User {
  id                            String                   @id @default(cuid())
  externalId                    String                   @unique
  name                          String
  email                         String                   @unique
  // #970: «sist sett»-språk — det språket brukeren hadde appen på ved siste forespørsel. Skrives
  // sammen med lastLoginAt. Brukes av e-post som ikke har en besvarelse å lese språket fra
  // (påminnelser, tildelinger, diskusjonsvarsler). Null = aldri logget inn → env.DEFAULT_LOCALE.
  preferredLocale               String?
  department                    String?
  manager                       String?
  activeStatus                  Boolean                  @default(true)
  // #1139: den ukentlige e-posten fra båten. På som standard; slås av med bryteren på profilen (`PUT /api/me/preferences`, det
  // ENESTE stedet som skriver feltet). Arbeidsgiver ser det ikke: ingen admin-rute eller rapport leser det.
  weeklyEmailEnabled            Boolean                  @default(true)
  weeklyDigests                 WeeklyDigest[]
  lastLoginAt                   DateTime?
  isAnonymized                  Boolean                  @default(false)
  anonymizedAt                  DateTime?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  roleAssignments               RoleAssignment[]
  submissions                   Submission[]
  appealsCreated                Appeal[]                 @relation("AppealedBy")
  appealsResolved               Appeal[]                 @relation("AppealResolvedBy")
  manualReviewsAssigned         ManualReview[]           @relation("Reviewer")
  decisionsFinalised            AssessmentDecision[]     @relation("FinalisedBy")
  auditEventsAsActor            AuditEvent[]             @relation("AuditActor")
  certifications                CertificationStatus[]
  consents                      UserConsent[]
  deletionRequests              DeletionRequest[]
  courseCompletions             CourseCompletion[]
  courseSectionReads            CourseSectionRead[]
  courseEnrollments             CourseEnrollment[]       @relation("EnrolledUser")
  enrollmentsAssigned           CourseEnrollment[]       @relation("EnrollmentAssignedBy")
  classMemberships              ClassMember[]            @relation("ClassMembership")
  classMembersAdded             ClassMember[]            @relation("ClassMemberAddedBy")
  courseGroupAssignmentsCreated CourseGroupAssignment[]  @relation("CourseGroupAssignedBy")
  discussionThreadsAuthored     DiscussionThread[]       @relation("DiscussionThreadAuthor")
  discussionThreadsDeleted      DiscussionThread[]       @relation("DiscussionThreadDeletedBy")
  discussionRepliesAuthored     DiscussionReply[]        @relation("DiscussionReplyAuthor")
  discussionRepliesDeleted      DiscussionReply[]        @relation("DiscussionReplyDeletedBy")
  discussionSubscriptions       DiscussionSubscription[]
  agentAuthoringTokens          AgentAuthoringToken[]    @relation("AgentAuthoringTokens")
  contentOwnerships             ContentOwner[]           @relation("ContentOwnerships")
  courseVersionNotices          CourseVersionNotice[]
  // #1142: e-posten om nye kurs, én rad per person og kurs.
  courseAssignmentNotices       CourseAssignmentNotice[]
  // #934 skive 5a-2: beståtte per innlevering.
  modulePasses                  ModulePass[]
}

// AA-3 (#651): kortlivet, scopet token for agent-orkestrerte draft-operasjoner.
// Kun sha256-hashen lagres — hemmeligheten (aat_...) vises én gang ved utstedelse.
// Per installasjon (multitenant): tokens utstedes og verifiseres kun mot denne
// installasjonens database og kan aldri brukes på tvers.
model AgentAuthoringToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  label      String?
  userId     String
  user       User      @relation("AgentAuthoringTokens", fields: [userId], references: [id], onDelete: Cascade)
  // Snapshot of the issuer's effective roles at issuance (JSON array of AppRole).
  // Entra app-role-claim roles are NOT persisted as RoleAssignments, so re-deriving
  // them at token-auth time would drop them (→ 403). Freezing them here binds the
  // token to exactly the roles the user was authorized with when they created it.
  rolesJson  String    @default("[]")
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([userId])
}

model UserConsent {
  id             String   @id @default(cuid())
  userId         String
  consentVersion String
  acceptedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentVersion])
  @@index([userId])
}

// #726: retry-safe idempotency for create/import POST endpoints. A request may carry an `Idempotency-Key`
// header; the first request for (userId, endpoint, key) reserves a row (status "pending"), runs the
// handler, and stores its response. A replay with the SAME key + SAME payloadHash returns the stored
// response (no second write); a SAME key + DIFFERENT payloadHash is rejected (409). Rows expire after a
// TTL (no relation to User on purpose — the record is ephemeral and must survive user changes for its TTL).
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String
  key          String
  payloadHash  String
  status       String   @default("pending") // "pending" while the handler runs, "completed" once stored
  statusCode   Int?
  responseJson String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
}

// #795: transactional outbox for the post-decision side effects (participant notification + course-
// completion check) that were previously fire-and-forget — a SIGTERM/crash after the job was marked
// SUCCEEDED but before those promises settled lost the email/completion with no retry. Now the decision
// path enqueues a durable OutboxEvent, and a delivery worker leases pending rows and delivers them with
// bounded retries (the handlers are idempotent, so re-delivery is safe).
model OutboxEvent {
  id          String    @id @default(cuid())
  type        String // "assessment_notification" | "course_completion_check"
  payloadJson String
  status      String    @default("pending") // "pending" | "delivered" | "failed"
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  availableAt DateTime  @default(now())
  lockedBy    String?
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([status, availableAt])
}

model DeletionRequest {
  id           String                @id @default(cuid())
  userId       String
  requestedAt  DateTime              @default(now())
  effectiveAt  DateTime?
  status       DeletionRequestStatus @default(PENDING)
  trigger      DeletionTrigger       @default(USER_REQUEST)
  anonymizedAt DateTime?
  cancelledAt  DateTime?
  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, effectiveAt])
  @@index([userId, status])
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model RoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  appRole   AppRole
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime  @default(now())
  createdBy String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, validFrom, validTo])
}

model Module {
  id                     String                  @id @default(cuid())
  title                  String
  description            String?
  certificationLevel     String?
  // #1049: forfatterens forventede svarlengde. NULL = nivåets standard (LEVEL_SCOPE).
  //
  // Ligger her, ved siden av certificationLevel, fordi det er det paret vi skiller: nivået sier
  // hvor sammensatt oppgaven kan være, omfanget hvor mye som skal skrives. De to har samme
  // livsløp og samme rolle — begge er forfatterinnstillinger som leses ved GENERERING, som er
  // tilstandsløs og ikke kan slå opp en modulversjon som ikke finnes ennå.
  scopeMinWords          Int?
  scopeMaxWords          Int?
  validFrom              DateTime?
  validTo                DateTime?
  activeVersionId        String?
  archivedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  versions               ModuleVersion[]         @relation("ModuleVersions")
  activeVersion          ModuleVersion?          @relation("ActiveModuleVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  submissions            Submission[]
  mcqQuestions           MCQQuestion[]
  mcqSetVersions         MCQSetVersion[]
  certificationStatuses  CertificationStatus[]
  rubricVersions         RubricVersion[]
  promptTemplateVersions PromptTemplateVersion[]
  courseItems            CourseItem[]
  // #934 skive 5a-2: beståtte per innlevering, og den laveste hovedversjonen som teller per kurs.
  modulePasses           ModulePass[]
  courseRequirements     CourseModuleRequirement[]
}

// Whether a module bundles a free-text submission (LLM-graded) plus MCQ, or is MCQ-only
// (no free-text, no LLM evaluation — pass/fail decided purely on the MCQ score). Defaults to
// FREETEXT_PLUS_MCQ so existing modules are unchanged (#525).
enum AssessmentMode {
  FREETEXT_PLUS_MCQ
  MCQ_ONLY
  FREETEXT_ONLY
}

model ModuleVersion {
  id                       String                 @id @default(cuid())
  moduleId                 String
  versionNo                Int
  // #934 skive 5a-2: versjonsnummeret, hoved.mindre. Tomt for utkast. Settes én gang, første gang versjonen
  // publiseres, under den eksklusive innholdslåsen, og endres aldri etterpå. `versionNo` står som løpenummer.
  versionMajor             Int?
  versionMinor             Int?
  // taskText / rubricVersionId / promptTemplateVersionId are free-text-assessment specific and
  // are null for MCQ_ONLY modules (#525). They remain set for FREETEXT_PLUS_MCQ and FREETEXT_ONLY.
  taskText                 String?
  assessorExpectedContent  String?
  candidateTaskConstraints String?
  // #1124 del 2: et sterkt eksempelsvar på fritekstoppgaven (språkkart). Vises deltakeren bare ETTER
  // vurderingen, og bare når modulen slår det på (`assessmentPolicy.practical.modelAnswerAfterAssessment`),
  // gjennom én egen rute. Deltakerens moduloppslag henter det aldri.
  modelAnswer              String?
  assessmentBlueprint      String?
  rubricVersionId          String?
  promptTemplateVersionId  String?
  // mcqSetVersionId is null for FREETEXT_ONLY modules (#578) — no multiple-choice component.
  mcqSetVersionId          String?
  assessmentMode           AssessmentMode         @default(FREETEXT_PLUS_MCQ)
  submissionSchemaJson     String?
  assessmentPolicyJson     String?
  publishedBy              String?
  publishedAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  module                   Module                 @relation("ModuleVersions", fields: [moduleId], references: [id], onDelete: Restrict)
  activeForModules         Module[]               @relation("ActiveModuleVersion")
  rubricVersion            RubricVersion?         @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)
  promptTemplateVersion    PromptTemplateVersion? @relation(fields: [promptTemplateVersionId], references: [id], onDelete: Restrict)
  mcqSetVersion            MCQSetVersion?         @relation(fields: [mcqSetVersionId], references: [id], onDelete: Restrict)
  submissions              Submission[]
  assessmentDecisions      AssessmentDecision[]
  llmEvaluations           LLMEvaluation[]
  // #997: sertifiseringer denne versjonen gjorde foreldet (revisjon merket ved publisering).
  supersededCertifications CertificationStatus[]  @relation("SupersededCertifications")
  modulePasses             ModulePass[]

  @@unique([moduleId, versionNo])
  // #934 skive 5a-2: to publiseringer kan ikke få samme nummer. PostgreSQL regner tomme verdier som ulike, så utkast
  // treffer ikke nøkkelen.
  @@unique([moduleId, versionMajor, versionMinor])
  @@index([moduleId, publishedAt])
}

model Submission {
  id                 String               @id @default(cuid())
  userId             String
  moduleId           String
  moduleVersionId    String
  locale             String               @default("en-GB")
  deliveryType       String
  responseJson       String               @default("{}")
  // #475: AI-use process signals — the participant's AI-use declaration + nudge choice. Additive,
  // nullable, aggregate-only (no keystroke/paste telemetry). Shape: aiInfluenceSignalsCodec.
  processSignalsJson String?
  attachmentUri      String?
  submittedAt        DateTime             @default(now())
  submissionStatus   SubmissionStatus     @default(SUBMITTED)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  module             Module               @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  moduleVersion      ModuleVersion        @relation(fields: [moduleVersionId], references: [id], onDelete: Restrict)
  mcqAttempts        MCQAttempt[]
  llmEvaluations     LLMEvaluation[]
  decisions          AssessmentDecision[]
  appeals            Appeal[]
  manualReviews      ManualReview[]
  assessmentJobs     AssessmentJob[]
  modulePass         ModulePass?

  @@index([userId, submittedAt])
  @@index([moduleId, submittedAt])
}

model MCQSetVersion {
  id        String          @id @default(cuid())
  moduleId  String
  versionNo Int
  title     String
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  module    Module          @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  questions MCQQuestion[]
  attempts  MCQAttempt[]
  versions  ModuleVersion[]

  @@unique([moduleId, versionNo])
}

model MCQQuestion {
  id              String        @id @default(cuid())
  mcqSetVersionId String
  moduleId        String
  stem            String
  optionsJson     String
  correctAnswer   String
  rationale       String?
  // #1077: 'single' (ett riktig svar, correctAnswer er fasiten) · 'multiple' (velg alle som stemmer:
  // answerKeyJson = {"correct":[posisjoner i optionsJson]}, correctAnswer = første riktige, for lesere
  // som ikke kjenner typen). Se doc/DESIGN_1077.md.
  questionType    String        @default("single")
  answerKeyJson   String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  mcqSetVersion   MCQSetVersion @relation(fields: [mcqSetVersionId], references: [id], onDelete: Restrict)
  module          Module        @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  responses       MCQResponse[]

  @@index([mcqSetVersionId, active])
}

model MCQAttempt {
  id              String        @id @default(cuid())
  submissionId    String
  mcqSetVersionId String
  startedAt       DateTime
  // #1062: hvilke spørsmål forsøket fikk, i rekkefølge (JSON-liste av questionId). Null for
  // forsøk fra før — de betyr «alle aktive i settet, lagret rekkefølge».
  questionOrderJson String?
  completedAt     DateTime?
  rawScore        Int?
  scaledScore     Float?
  percentScore    Float?
  createdAt       DateTime      @default(now())
  submission      Submission    @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  mcqSetVersion   MCQSetVersion @relation(fields: [mcqSetVersionId], references: [id], onDelete: Restrict)
  responses       MCQResponse[]

  @@index([submissionId, completedAt])
}

model MCQResponse {
  id             String      @id @default(cuid())
  mcqAttemptId   String
  questionId     String
  selectedAnswer String
  // #1077: deltakerens svar for typene som ikke er én tekst ('multiple': {"selected":[posisjoner]}).
  // selectedAnswer er da de valgte alternativene som lesbar tekst.
  answerJson     String?
  isCorrect      Boolean
  createdAt      DateTime    @default(now())
  mcqAttempt     MCQAttempt  @relation(fields: [mcqAttemptId], references: [id], onDelete: Restrict)
  question       MCQQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  // #794: one response per (attempt, question) as a DB invariant — the delete+recreate finalization
  // can't leave duplicate answers even under a retry/race.
  @@unique([mcqAttemptId, questionId])
}

model RubricVersion {
  id              String               @id @default(cuid())
  moduleId        String
  versionNo       Int
  criteriaJson    String
  scalingRuleJson String
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  module          Module               @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  moduleVersions  ModuleVersion[]
  decisions       AssessmentDecision[]

  @@unique([moduleId, versionNo])
}

model PromptTemplateVersion {
  id                 String               @id @default(cuid())
  moduleId           String
  versionNo          Int
  systemPrompt       String
  userPromptTemplate String
  examplesJson       String
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  module             Module               @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  moduleVersions     ModuleVersion[]
  llmEvaluations     LLMEvaluation[]
  decisions          AssessmentDecision[]

  @@unique([moduleId, versionNo])
}

model LLMEvaluation {
  id                      String                @id @default(cuid())
  submissionId            String
  moduleVersionId         String
  modelName               String
  promptTemplateVersionId String
  requestPayloadHash      String
  responseJson            String
  rubricTotal             Int
  practicalScoreScaled    Float
  passFailPractical       Boolean
  manualReviewRecommended Boolean
  confidenceNote          String?
  evaluatedAt             DateTime              @default(now())
  createdAt               DateTime              @default(now())
  submission              Submission            @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  moduleVersion           ModuleVersion         @relation(fields: [moduleVersionId], references: [id], onDelete: Restrict)
  promptTemplateVersion   PromptTemplateVersion @relation(fields: [promptTemplateVersionId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
}

model AssessmentDecision {
  id                      String                 @id @default(cuid())
  submissionId            String
  moduleVersionId         String
  // null for MCQ_ONLY decisions — there is no rubric/prompt-based LLM evaluation (#525).
  rubricVersionId         String?
  promptTemplateVersionId String?
  mcqScaledScore          Float
  practicalScaledScore    Float
  totalScore              Float
  redFlagsJson            String
  // #475 Phase 2: computed AI-influence signals at decision time (declaration outcome +
  // content-similarity). Additive, nullable, transparent (not a black box). A REVIEW signal only —
  // never contributes to pass/fail. Shape: aiInfluenceDecisionCodec.
  aiInfluenceJson         String?
  passFailTotal           Boolean
  decisionType            DecisionType
  decisionReason          String
  // #950: HVA som avgjorde, som data. decisionReason er én tekst som serveren skriver på engelsk;
  // klienten kan ikke oversette den ved å slå den opp, og feltet inneholder dessuten fritekst en
  // sensor har skrevet selv. En rad MED kode er maskinskrevet og formuleres på deltakerens språk;
  // en rad UTEN kode er et menneskes egne ord (eller eldre enn dette feltet) og vises ordrett.
  decisionReasonCode      String?
  // Tallene setningen trenger (terskler, poeng), som JSON. Null når grunnen ikke har tall.
  decisionReasonParams    String?
  finalisedAt             DateTime               @default(now())
  finalisedById           String?
  parentDecisionId        String?
  createdAt               DateTime               @default(now())
  submission              Submission             @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  moduleVersion           ModuleVersion          @relation(fields: [moduleVersionId], references: [id], onDelete: Restrict)
  rubricVersion           RubricVersion?         @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)
  promptTemplateVersion   PromptTemplateVersion? @relation(fields: [promptTemplateVersionId], references: [id], onDelete: Restrict)
  finalisedBy             User?                  @relation("FinalisedBy", fields: [finalisedById], references: [id], onDelete: SetNull)
  parentDecision          AssessmentDecision?    @relation("DecisionLineage", fields: [parentDecisionId], references: [id], onDelete: SetNull)
  childDecisions          AssessmentDecision[]   @relation("DecisionLineage")
  certifications          CertificationStatus[]
  modulePasses            ModulePass[]

  @@index([submissionId, finalisedAt])
}

model Appeal {
  id             String       @id @default(cuid())
  submissionId   String
  appealedById   String
  appealReason   String
  appealStatus   AppealStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  claimedAt      DateTime?
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  submission     Submission   @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  appealedBy     User         @relation("AppealedBy", fields: [appealedById], references: [id], onDelete: Restrict)
  resolvedBy     User?        @relation("AppealResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([appealStatus, createdAt])
  @@index([appealStatus, claimedAt])
}

model ManualReview {
  id               String       @id @default(cuid())
  submissionId     String
  triggerReason    String
  reviewerId       String?
  reviewStatus     ReviewStatus @default(OPEN)
  reviewedAt       DateTime?
  overrideDecision String?
  overrideReason   String?
  createdAt        DateTime     @default(now())
  submission       Submission   @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewer         User?        @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([reviewStatus, createdAt])
}

// #820: certification lifecycle states. Previously CertificationStatus.status was free-text String and
// "passed" was inferred as status != 'NOT_CERTIFIED' — safe only because the sole writer is union-typed;
// a raw-SQL/untyped writer could store a typo that reads as "passed". A Postgres enum is a DB-level CHECK
// that rejects any value outside this set. Passing states are all of these except NOT_CERTIFIED.
enum CertificationLifecycleStatus {
  ACTIVE
  DUE_SOON
  DUE
  EXPIRED
  NOT_CERTIFIED
  // #997: modulen er revidert etter at deltakeren besto den. Statusen bevares (dato og vedtak
  // står), men teller ikke som bestått — verdien står med vilje UTENFOR
  // CERTIFICATION_PASSED_STATUSES.
  SUPERSEDED
}

model CertificationStatus {
  id                     String                       @id @default(cuid())
  userId                 String
  moduleId               String
  latestDecisionId       String
  status                 CertificationLifecycleStatus
  passedAt               DateTime?
  // #989/#991: utløpsdatoer skrives ikke lenger (moduler utløper til de revideres). Kolonnen står
  // igjen med vilje: innsynseksporten (`/api/me`) oppgir den som HISTORIKK om personen. Søsteren
  // `recertificationDueDate` og indeksen på denne ble droppet i kontraktsfasen 19.09 — de hadde
  // ingen lesere.
  expiryDate             DateTime?
  // #997: hvilken modulversjon som gjorde denne beståtten foreldet. Null for alle andre statuser.
  supersededByVersionId  String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  user                   User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  module                 Module                       @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  latestDecision         AssessmentDecision           @relation(fields: [latestDecisionId], references: [id], onDelete: Restrict)
  supersededByVersion    ModuleVersion?               @relation("SupersededCertifications", fields: [supersededByVersionId], references: [id], onDelete: SetNull)

  @@unique([userId, moduleId])
  @@index([moduleId, status])
}

// #934 skive 5a-2 (doc/DESIGN_934.md, «5a»): én rad per bestått innlevering. Skrives der alle vedtak går gjennom
// (`upsertCertificationStatusFromDecision`), under deltakerlåsen. Et senere stryk på SAMME innlevering sletter raden; et
// stryk på en annen rører den ikke (produkteier 2026-11-03, svar f). Ingen leser fremdrift herfra før 5a-3.
//
// Radene kan bygges på nytt fra vedtakene (tilbakefyllingen), så de følger det de er regnet ut fra: sletting
// av innlevering, vedtak, versjon, modul eller bruker tar raden med seg, og ingen gammel kode blir stoppet av dem.
model ModulePass {
  id              String             @id @default(cuid())
  userId          String
  moduleId        String
  submissionId    String             @unique
  decisionId      String
  moduleVersionId String
  // Når vedtaket ble fattet. Regelen ser ikke på tidspunktet (doc/DESIGN_934.md, «Hvorfor dagens #997 ikke holder»).
  passedAt        DateTime
  // Settes bare av tilbakefyllingen, for beståtte som #997 tok bort. En slik rad teller aldri.
  invalidatedAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  module          Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submission      Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  decision        AssessmentDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  moduleVersion   ModuleVersion      @relation(fields: [moduleVersionId], references: [id], onDelete: Cascade)

  @@index([userId, moduleId])
  @@index([moduleId])
  @@index([moduleVersionId])
  @@index([decisionId])
}

// #934 skive 5a-2: for hvert kurs og hver modul i det, den laveste hovedversjonen av modulen som teller der. Heves bare av
// en hovedversjon, senkes aldri, og raden slettes når modulen tas ut av kurset. Skrives under innholdslåsen.
model CourseModuleRequirement {
  id             String   @id @default(cuid())
  courseId       String
  moduleId       String
  minModuleMajor Int
  // #1140 etappe 1 (doc/DESIGN_1140.md): hovedversjonen av modulen dette kurset VISER. Tomt = kurset følger modulens nyeste, som
  // før #1140. `minModuleMajor` over er hvilke beståtte som teller; dette er hva en deltaker får når hen åpner modulen. Leses
  // bare gjennom `findShownModuleMajors` (moduleVersioning.ts), og INGEN skriver feltet før etappe 3 gir det sin ene skriver.
  // DB-CHECK i migreringen: tomt, eller minst `minModuleMajor` (ellers kunne kravet aldri oppfylles av det deltakeren får).
  shownModuleMajor Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module         Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([courseId, moduleId])
  @@index([moduleId])
}

model AuditEvent {
  id           String   @id @default(cuid())
  // #804: tamper-evidence. chainSeq gives a deterministic total order for the hash chain (timestamps can
  // collide at ms granularity); prevHash links each event to the prior one so altering/removing any row
  // breaks the chain from that point. payloadHash now covers actor + timestamp + prevHash (see
  // auditService.recordAuditEvent). Writes are serialized with a pg advisory lock so the chain stays
  // linear under concurrency. Nullable prevHash tolerates the pre-#804 genesis row after backfill.
  chainSeq     BigInt   @unique @default(autoincrement())
  prevHash     String?
  entityType   String
  entityId     String
  action       String
  actorId      String?
  timestamp    DateTime @default(now())
  payloadHash  String
  metadataJson String
  // #797: denormalized copy of the related submission id (from entityId when entityType='submission', or
  // from metadata.submissionId otherwise) so the participant audit-trail read is an indexed equality
  // lookup instead of an unindexable `metadataJson LIKE '%…%'` seq scan. Not an FK — the audit row must
  // survive submission deletion.
  submissionId String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, timestamp])
  @@index([submissionId, timestamp])
  // #807: retention purges by (action IN … AND timestamp < cutoff); without this index that was a seq
  // scan over the whole indefinitely-growing table on every run.
  @@index([action, timestamp])
}

model AssessmentJob {
  id             String              @id @default(cuid())
  submissionId   String
  status         AssessmentJobStatus @default(PENDING)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  availableAt    DateTime            @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  leaseExpiresAt DateTime?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  submission     Submission          @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([submissionId, createdAt])
}

model Course {
  id                 String                  @id @default(cuid())
  title              String // lokalisert JSON: {"en-GB":"...","nb":"...","nn":"..."}
  description        String? // lokalisert JSON
  certificationLevel String?
  // #496/EN-1: OPEN = visible to everyone (current behavior, default for existing courses);
  // RESTRICTED = visible/available only to enrolled users.
  enrollmentPolicy   CourseEnrollmentPolicy  @default(OPEN)
  // #495/T-QA-1: kurs-master av/på for diskusjon. Default true => eksisterende publiserte
  // kurs får diskusjon på når feature lander (besluttet 2026-06-27). Effektiv regel for et
  // item: Course.discussionsEnabled && CourseItem.discussionsEnabled.
  discussionsEnabled Boolean                 @default(true)
  // 2.119.0: e-post til kursets eiere når en deltaker stiller et nytt spørsmål. Kursets eiere slår
  // den av og på; den gjelder alle eierne. Svar går fortsatt bare til trådens abonnenter.
  discussionOwnerNotifications Boolean       @default(true)
  // 2.121.0: kursets navn i delingslenka (/kurs/<slug>). Settes første gang kurset publiseres, fra
  // tittelen på bokmål, og endres aldri etterpå — en utsendt lenke skal virke også etter et navnebytte.
  // Null før første publisering: forfatteren kan bytte tittel fritt til da.
  slug                         String?       @unique
  // #1093: valgfri plassering i «Mine kurs». Satt: først, stigende. Tomt (det vanlige): alfabetisk
  // på tittelen i deltakerens språk. Regelen bor i courseOrdering.ts.
  sortOrder          Int?
  // #934: hovedversjon og mindre versjon (3.0 → 3.1 mindre, 3.x → 4.0 hoved). Innholdsansvarlig velger
  // ved publisering. Et kursbevis gjelder sin hovedversjon; mindre versjon har ingen konsekvens for
  // utstedte bevis. Eksisterende kurs er 1.0. Se doc/DESIGN_934.md.
  versionMajor       Int                     @default(1)
  versionMinor       Int                     @default(0)
  // #934 skive 4a: øker hver gang kursets innhold eller innstillinger lagres (`claimCourseRevision`). Kursskjemaet
  // sender tallet det lastet; er det endret siden, har noen andre lagret, og lagringen avvises (409). Ingen lås:
  // den gjelder en fane som har stått åpen, ikke to som skriver samtidig.
  contentRevision    Int                     @default(0)
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  items              CourseItem[]
  completions        CourseCompletion[]
  // #934 skive 3: én rad per hovedversjon, for regelen om endrede seksjoner.
  versions           CourseVersion[]
  // #934 skive 4b: e-posten om ny hovedversjon, én rad per person og versjon.
  versionNotices     CourseVersionNotice[]
  // #1142: e-posten om nye kurs, én rad per person og kurs.
  assignmentNotices  CourseAssignmentNotice[]
  sectionReads       CourseSectionRead[]
  enrollments        CourseEnrollment[]
  groupAssignments   CourseGroupAssignment[]
  discussionThreads  DiscussionThread[]
  // 2.102.0: tema samler kursene i «Mine kurs». Et kurs kan ha flere, eller ingen.
  themes             CourseThemeAssignment[]
  // #934 skive 5a-2: den laveste hovedversjonen av hver modul som teller i dette kurset.
  moduleRequirements CourseModuleRequirement[]
  // #1140 etappe 2: utkastet til neste utgave av kurset. Høyst ett. Navnet er med vilje ikke `draft`: vakta
  // (test/course-draft-guard.test.js) finner enhver bruk av ordet `courseDraft` utenfor fila som eier tabellen, også
  // `include: { courseDraft: true }`. `draft` brukes til annet i koden og kunne ikke vært søkt etter.
  courseDraft        CourseDraft?
}

// #1140 etappe 2 (doc/design/PLAN_1140_E2.md): utkastet til et PUBLISERT kurs. «Lagre» i kursbyggeren skriver hit, og ingenting
// deltakerne ser, endres før utkastet publiseres. Bare kursbyggerens ruter leser tabellen (src/modules/course/courseDraft.ts,
// vakt: test/course-draft-guard.test.js). Alt deltakerne leser, står i `Course` og `CourseItem`, som før.
//
// `payloadText` er det `PUT …/content` tar imot, etter validering: felt som er utelatt, betyr «som publisert». TEKST, ikke Json:
// publiseringen leser den gjennom samme skjema som lagringen. `baseRevision` er kursets `contentRevision` slik skjemaet lastet
// den; publiseringen avvises hvis kurset er endret siden. `revision` er utkastets egen teller, og gjelder sammen med `id`:
// en forkastet og ny rad starter på nytt.
model CourseDraft {
  id           String   @id @default(cuid())
  courseId     String   @unique
  payloadText  String
  baseRevision Int
  revision     Int      @default(1)
  // Hvor siste skriving kom fra: `form` (kursbyggeren). `import` kommer i etappe 4 (kursfil og skillet).
  source       String   @default("form")
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// 2.102.0: et tema i «Mine kurs» (produkteier 2026-10-25: «det blir relativt mange kurs som er
// vanskelig å holde styr på»). Bare administrator lager og endrer tema; kurset velger sine inne i
// kursredigeringen. Lista står alltid alfabetisk, så det finnes ingen rekkefølge her.
model CourseTheme {
  id        String                  @id @default(cuid())
  name      String // lokalisert JSON: {"en-GB":"...","nb":"...","nn":"..."}
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  courses   CourseThemeAssignment[]
}

// Koblingen kurs ↔ tema. Slettes et tema eller et kurs, forsvinner koblingen — og ingenting annet.
model CourseThemeAssignment {
  courseId  String
  themeId   String
  createdAt DateTime    @default(now())
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  theme     CourseTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([courseId, themeId])
  @@index([themeId])
}

model CourseCompletion {
  id                  String   @id @default(cuid())
  userId              String
  courseId            String
  completedAt         DateTime @default(now())
  certificateId       String   @unique @default(cuid())
  moduleSnapshotJson  String // JSON-array av moduleIds som inngikk ved fullføring
  // #933: JSON-array av sectionIds som inngikk ved fullføring. Produkteiers regel er at man har
  // bestått «alle moduler kurset inneholdt DA, samt bekreftet lest alle seksjoner kurset inneholdt
  // på det tidspunkt» — men bare modulene ble lagret, så halve regelen var uetterprøvbar.
  //
  // Nullable med vilje: `null` betyr ærlig «utstedt før vi registrerte dette», ikke «ingen
  // seksjoner». Å bakfylle med `[]` ville påstått at gamle kurs var seksjonsfrie.
  // Additivt felt — expand/contract-trygt, gamle containere leser det aldri.
  sectionSnapshotJson String?
  // #934: versjonen av kurset beviset ble utstedt for. Beviset gjelder hovedversjonen — én per
  // hovedversjon per deltaker. Eksisterende bevis er 1.0, som kursene de ble utstedt for.
  versionMajor        Int      @default(1)
  versionMinor        Int      @default(0)
  // #1145: `platform` = utstedt av plattformen (kravet målt); `external` = registrert av administrator for et kurs tatt utenfor
  // plattformen (doc/design/PLAN_1145.md). Et `external`-bevis har ingen kjent dato: `completedAt` er registreringen og vises
  // aldri som fullføringsdato, og det teller ikke som aktivitet. `source` er det ENESTE skillet — ikke `registeredById`, som
  // står igjen når beviset senere oppgraderes til `platform`.
  source              String   @default("platform")
  // Administratoren som registrerte (ingen fremmednøkkel: revisjonen har aktøren, og raden skal stå om kontoen slettes).
  registeredById      String?
  // Hvor registreringen kom fra, uten personopplysninger (f.eks. «Kurs og sertifisering.xlsx, Modul 2»).
  externalReference   String?
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  // #934: ett bevis per hovedversjon. Den gamle nøkkelen (bruker, kurs) sto i 2.127.0 og er fjernet i
  // 2.128.0 (skive 2), i samme utrulling som leserne lærte å skille versjonene.
  @@unique([userId, courseId, versionMajor])
  @@index([courseId, completedAt])
}

// #934 skive 3: én rad per hovedversjon av et kurs. Brukes bare til regelen om endrede seksjoner
// (produkteier 2026-11-01): en seksjon som er endret siden forrige hovedversjon, leses på nytt.
//
// `sectionVersionsJson` er seksjon → aktiv seksjonsversjon (id, eller null). Når hovedversjon N lages,
// skrives raden for N−1 med det som gjaldt RETT FØR endringen (slutten av N−1), og raden for N med det
// som gjelder rett etter, i samme transaksjon som versjonen økes. En seksjon er endret i N når de to
// radene sier ulik versjon; en lesing teller for N når seksjonen er uendret, eller lesingen er gjort
// etter `publishedAt` for N. Kursets innhold lagres ikke her — det står i kursbevisets øyeblikksbilde.
// Kurs uten rader (alle på 1.x) har ingen slik regel: alle lesinger teller, som før.
model CourseVersion {
  id                  String   @id @default(cuid())
  courseId            String
  versionMajor        Int
  publishedAt         DateTime
  sectionVersionsJson String
  // #934 skive 4b: hvor mange elementer som er nye eller endret i denne hovedversjonen (seksjoner med ny versjon,
  // elementer lagt til). Regnet ut når hovedversjonen lages, og står i e-posten til deltakerne. Null for rader
  // fra før 4b, og for raden som avslutter forrige hovedversjon.
  changedItemCount    Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, versionMajor])
}

// #934 skive 4b: én rad per person og hovedversjon — e-posten om at kurset har fått en ny hovedversjon
// (doc/DESIGN_934.md, «4b»). Radene lages i `applyCourseVersionChange`, i samme transaksjon som hovedversjonen,
// også når e-posten er slått av, så ingen e-post går tapt. Workeren sender dem (`courseMajorVersionEmail.ts`).
//
// status: "waiting" (venter: kurset er avpublisert, eller jobben er av) | "queued" (lagt i outboxen) |
//         "sending" | "sent" | "skipped" (ikke aktuell lenger: nyere hovedversjon, eller personen er borte) |
//         "uncertain" (et forsøk ble avbrutt og kan ha gått; sendes ikke på nytt) | "failed"
model CourseVersionNotice {
  id           String    @id @default(cuid())
  courseId     String
  versionMajor Int
  userId       String
  status       String    @default("waiting")
  // Hvorfor raden ble `skipped`, `uncertain` eller `failed`.
  reason       String?
  queuedAt     DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, versionMajor, userId])
  @@index([status, createdAt])
}

// #1142: én rad per person og kurs — e-posten om nye kurs fra en klasse (doc/design/PLAN_1142.md). Raden betyr
// «denne personen er varslet, eller skal varsles, om dette kurset». Finnes raden, kommer det aldri en ny e-post om
// samme kurs. Radene lages av en jobb i workeren fra regelen `eligibleAssignmentPairs`
// (`src/modules/course/courseAssignmentNotice.ts`), aldri av handlingene, og skrives bare der (vakt:
// test/course-assignment-notice-write-guard.test.js).
//
// status: "baseline" (hadde kurset da #1142 kom; sendes aldri) | "waiting" | "queued" (med i en samlet e-post,
//         `batchId`) | "sending" | "sent" | "uncertain" (avbrutt underveis; sendes ikke på nytt) | "failed"
model CourseAssignmentNotice {
  id        String    @id @default(cuid())
  userId    String
  courseId  String
  // baseline | waiting | queued | sending | sent | uncertain | failed
  status    String    @default("waiting")
  // Satt når raden er med i en samlet e-post (status queued og videre). Behandleren i outboxen finner radene på den.
  batchId   String?
  reason    String?
  queuedAt  DateTime?
  // Settes eksplisitt ved overgangen til `sending`. Ryddingen måler på denne, ikke på `updatedAt` (Codex runde 1 nr. 3).
  sendingAt DateTime?
  sentAt    DateTime?
  // #1146: når personen sist ble varslet om kurset, eller regnet som varslet (`sending`, `baseline`). Kommer kurset tilbake
  // etter dette (alle åpne veier er nyere), settes raden tilbake til `waiting`. Null mens raden venter eller er i kø.
  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([status, userId, createdAt])
  @@index([batchId])
}

// #496/EN-1: assignment of a course to a participant (individual, department, or self-enrollment),
// with an optional due date. Status (ASSIGNED/IN_PROGRESS/OVERDUE/COMPLETED) is NOT STORED; it is
// derived from CourseCompletion + section/module progress + dueAt to avoid status drift.
enum CourseEnrollmentPolicy {
  OPEN
  RESTRICTED
}

enum CourseEnrollmentSource {
  INDIVIDUAL
  DEPARTMENT
  SELF
}

model CourseEnrollment {
  id           String                 @id @default(cuid())
  userId       String
  courseId     String
  assignedById String? // SMO/admin who assigned; null for self-enrollment (source=SELF)
  source       CourseEnrollmentSource
  dueAt        DateTime? // optional due date
  assignedAt   DateTime               @default(now())
  revokedAt    DateTime? // soft revoke: keep history/audit
  user         User                   @relation("EnrolledUser", fields: [userId], references: [id], onDelete: Cascade)
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedBy   User?                  @relation("EnrollmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId, revokedAt])
  // #798: course reminder scan range-filters dueAt (<= horizon); index the range column.
  @@index([dueAt])
}

// #645/CL-1: a "class" (klasse) — a platform-owned, many-to-many cohort used to assign courses to a
// group of participants. kind=MANUAL classes have explicit ClassMember rows; kind=ENTRA classes
// (CL-5, gated by PlatformConfig.classEntraLinkingEnabled) derive membership from the user's Entra
// group claims instead. isSystem marks built-in classes like "Alle deltakere" (all PARTICIPANTs).
enum ClassKind {
  MANUAL
  ENTRA
}

model Class {
  id                String                  @id @default(cuid())
  name              String
  description       String?
  kind              ClassKind               @default(MANUAL)
  entraGroupId      String? // set only for kind=ENTRA (CL-5)
  isSystem          Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  archivedAt        DateTime?
  members           ClassMember[]
  courseAssignments CourseGroupAssignment[]

  @@index([archivedAt])
}

model ClassMember {
  classId   String
  userId    String
  addedById String?
  addedAt   DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation("ClassMembership", fields: [userId], references: [id], onDelete: Cascade)
  addedBy   User?    @relation("ClassMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([classId, userId])
  @@index([userId])
}

// Dynamic assignment of a course to a class (#645/CL-1). A participant is assigned the course if they
// are a member of any assigned class — evaluated at read time, never materialised to CourseEnrollment.
model CourseGroupAssignment {
  id           String    @id @default(cuid())
  courseId     String
  classId      String
  dueAt        DateTime?
  assignedById String?
  createdAt    DateTime  @default(now())
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignedBy   User?     @relation("CourseGroupAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([courseId, classId])
  @@index([classId])
  // #798: course reminder scan range-filters dueAt (<= horizon); index the range column.
  @@index([dueAt])
}

// Læringsseksjon i et kurs (#476/#481). Speiler Module/ModuleVersion: innholdet
// ligger i immutable, versjonerte rader slik at historiske besvarelser/visninger
// kan fryses mot en bestemt versjon. Kobles til kurs via CourseItem (#480/F1).
model CourseSection {
  id              String                 @id @default(cuid())
  title           String // lokalisert JSON: {"en-GB":"...","nb":"...","nn":"..."}
  activeVersionId String?
  archivedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  versions        CourseSectionVersion[] @relation("CourseSectionVersions")
  activeVersion   CourseSectionVersion?  @relation("ActiveCourseSectionVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  courseItems     CourseItem[]
  reads           CourseSectionRead[]
  assets          SectionAsset[]
}

// Media-asset (bilde) for en læringsseksjon (#483/F4). Binæren ligger i Azure Blob
// (privat container); denne raden er metadata + blob-sti. Refereres fra markdown via
// `asset:<id>`-URL i et vanlig bilde (`![alt](asset:<id>)`), som resolves til serve-
// endepunktet ved render.
model SectionAsset {
  id                 String        @id @default(cuid())
  sectionId          String
  filename           String
  mimeType           String
  blobPath           String
  sizeBytes          Int
  createdAt          DateTime      @default(now())
  // #657: localized SVG variants. sourceLocale is the language of the text baked into the
  // original (blobPath); localizedBlobPaths maps each OTHER supported locale → the blob path of
  // a variant whose <text> has been translated. Both null for raster images and untranslated SVGs.
  sourceLocale       String?
  localizedBlobPaths Json?
  // #1079: det smale oppsettet av samme figur, for en smal spalte (telefon). blobPath over er det
  // brede. Formen er { narrow: { blobPath, localizedBlobPaths } }, og den leses BARE gjennom
  // readLayoutVariants i assetCommands.ts. Null for raster og for figurer med ett oppsett.
  layoutVariants     Json?
  section            CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

// Per-deltaker lese-markering av en læringsseksjon i et kurs (#487/#492). Moduler
// "fullføres" via CertificationStatus; seksjoner markeres eksplisitt som lest. Begge
// teller mot kurs-progresjon (alle elementer teller).
model CourseSectionRead {
  id        String        @id @default(cuid())
  userId    String
  courseId  String
  sectionId String
  readAt    DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, sectionId])
  @@index([userId, courseId])
}

enum CourseItemType {
  MODULE
  SECTION
}

// Polymorf kurs-element (#480/F1): erstatter CourseModule-join og lar moduler og
// læringsseksjoner interleaves i ett ordnet forløp. CourseItem er eneste sannhetskilde;
// CourseModule ble droppet i #502 etter at både lese- og skrive-pathene var kuttet over.
// Nøyaktig én av moduleId/
// sectionId er satt, styrt av itemType (DB-CHECK i migreringen).
model CourseItem {
  id                 String             @id @default(cuid())
  courseId           String
  itemType           CourseItemType
  sortOrder          Int
  moduleId           String?
  sectionId          String?
  // #495/T-QA-1: per-item av/på. Toggle ligger her (kursets plassering av modulen/seksjonen),
  // ikke på den delte Module/CourseSection — så å skru av i ett kurs påvirker ikke samme
  // modul i et annet kurs. Default true (additivt, ikke-brytende).
  discussionsEnabled Boolean            @default(true)
  course             Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module             Module?            @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  section            CourseSection?     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  discussionThreads  DiscussionThread[]

  @@index([courseId, sortOrder])
  @@index([moduleId])
  @@index([sectionId])
}

model CourseSectionVersion {
  id                String          @id @default(cuid())
  sectionId         String
  versionNo         Int
  bodyMarkdown      String // lokalisert JSON av markdown-tekst, per locale
  publishedBy       String?
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  section           CourseSection   @relation("CourseSectionVersions", fields: [sectionId], references: [id], onDelete: Restrict)
  activeForSections CourseSection[] @relation("ActiveCourseSectionVersion")

  @@unique([sectionId, versionNo])
  @@index([sectionId, publishedAt])
}

// ── Diskusjon / Q&A (#495, T-QA-1) ────────────────────────────────────────────
// Tråder henger på kurs-nivå (courseItemId = null) eller på en konkret seksjon/modul
// (courseItemId satt). UGC er ÉNSPRÅKLIG ren tekst på forfatterens språk — IKKE den
// lokaliserte {en-GB,nb,nn}-JSON-formen authored content bruker. Soft-delete, aldri
// hard-delete: slettede innlegg beholder raden (deletedAt/deletedById) for trådintegritet.
// Design: doc/DISCUSSIONS_DESIGN.md.

enum DiscussionThreadKind {
  QUESTION
  DISCUSSION
}

enum DiscussionThreadStatus {
  OPEN
  RESOLVED
  LOCKED
}

model DiscussionThread {
  id              String                   @id @default(cuid())
  courseId        String
  courseItemId    String? // null = kurs-nivå board; satt = per seksjon/modul
  authorId        String
  kind            DiscussionThreadKind     @default(DISCUSSION)
  title           String // énspråklig UGC
  bodyMarkdown    String // énspråklig UGC (restriktiv render, ikke renderSectionMarkdown)
  status          DiscussionThreadStatus   @default(OPEN)
  acceptedReplyId String?                  @unique // satt når et svar er «løsning» (kun QUESTION)
  pinnedAt        DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?
  deletedById     String?
  course          Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseItem      CourseItem?              @relation(fields: [courseItemId], references: [id], onDelete: SetNull)
  author          User                     @relation("DiscussionThreadAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  deletedBy       User?                    @relation("DiscussionThreadDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  acceptedReply   DiscussionReply?         @relation("AcceptedReply", fields: [acceptedReplyId], references: [id], onDelete: SetNull)
  replies         DiscussionReply[]        @relation("ThreadReplies")
  subscriptions   DiscussionSubscription[]

  // #802: covers the thread-list query (WHERE courseId, courseItemId ORDER BY pinnedAt desc, updatedAt desc).
  @@index([courseId, courseItemId, pinnedAt, updatedAt])
  @@index([authorId])
}

model DiscussionReply {
  id                String            @id @default(cuid())
  threadId          String
  authorId          String
  bodyMarkdown      String // énspråklig UGC
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  deletedById       String?
  thread            DiscussionThread  @relation("ThreadReplies", fields: [threadId], references: [id], onDelete: Cascade)
  author            User              @relation("DiscussionReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  deletedBy         User?             @relation("DiscussionReplyDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  acceptedForThread DiscussionThread? @relation("AcceptedReply")

  // #802: covers the reply load (WHERE threadId ORDER BY createdAt asc).
  @@index([threadId, createdAt])
  @@index([authorId])
}

model DiscussionSubscription {
  id        String           @id @default(cuid())
  threadId  String
  userId    String
  createdAt DateTime         @default(now())
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

// #787: multi-owner content ownership. An owner *set* (not a single createdById) per content object,
// transferable by any current owner or an ADMINISTRATOR. Polymorphic (contentType + contentId) so one
// table + one guard covers Course/CourseSection/Class/Module. Referential cleanup of the content side is
// application-level on delete (polymorphic, no per-type FK); the userId side has a real FK + cascade.
model ContentOwner {
  id          String           @id @default(cuid())
  contentType ContentOwnerType
  contentId   String
  userId      String
  addedById   String? // who granted ownership (a current owner or admin); null for migration backfill
  addedAt     DateTime         @default(now())
  user        User             @relation("ContentOwnerships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contentType, contentId, userId])
  @@index([contentType, contentId])
  @@index([userId])
}

enum ContentOwnerType {
  COURSE
  SECTION
  CLASS
  MODULE
}

// #1139 skive 3 (doc/design/PLAN_1139.md, punkt 4, 6-8 og 12): én rad per person og uke for den ukentlige e-posten. Raden og
// hendelsen i utboksen lages i samme transaksjon, betinget (`ON CONFLICT ("userId","weekKey") DO NOTHING RETURNING`), så det
// aldri går to e-poster samme uke, heller ikke etter en omstart eller med to workere. Bare weeklyDigest-modulen og
// nøytraliseringen av en prod-kopi skriver tabellen; ingen admin-rute eller rapport leser den (arbeidsgiver ser ikke hvem som
// får, åpner eller melder seg av). Rader eldre enn 12 uker slettes av jobben.
model WeeklyDigest {
  id        String    @id @default(cuid())
  userId    String
  // Mandagen i uka e-posten gjelder, i Oslo: `YYYY-MM-DD`.
  weekKey   String
  // queued | sending | sent | skipped | uncertain | failed
  status    String
  reason    String?
  // Tidspunktet raden er satt opp til å sendes (`availableAt` på hendelsen). Jobben regner neste ledige tid fra den siste.
  queuedAt  DateTime?
  sendingAt DateTime?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([status, weekKey])
}
