    }
  },
  "sur | nn": {
    "line": "Vi ligg i daudvatnet. Eg seier ikkje noko. Eg berre nemner det.",
    "alt": "",
    "width": "600",
    "height": "200",
    "naturalWidth": 600,
    "naturalHeight": 200,
    "image": {
      "contentType": "image/jpeg",
