    }
  },
  "dramatisk | nb": {
    "line": "Jeg begynner å føle meg akterutseilt. Måkene er hyggelige, da.",
    "alt": "",
    "width": "600",
    "height": "200",
    "naturalWidth": 600,
    "naturalHeight": 200,
    "image": {
      "contentType": "image/jpeg",
      "bytes": 17460,
