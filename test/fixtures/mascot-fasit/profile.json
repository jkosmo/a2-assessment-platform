    }
  },
  "sur | en-GB": {
    "line": "We're stuck in dead water. I'm not saying anything. I'm just mentioning it.",
    "alt": "",
    "width": "600",
    "height": "200",
    "naturalWidth": 600,
    "naturalHeight": 200,
    "image": {
      "contentType": "image/jpeg",
