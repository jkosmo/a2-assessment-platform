    }
  },
  "dramatisk | nn": {
    "line": "Eg byrjar å kjenne meg akterutsegla. Måsane er hyggelege, då.",
    "alt": "",
    "width": "600",
    "height": "200",
    "naturalWidth": 600,
    "naturalHeight": 200,
