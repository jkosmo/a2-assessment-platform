  "sur | nb": {
    "line": "Vi ligger i dødvannet. Jeg sier ikke noe. Jeg bare nevner det.",
    "alt": "",
    "width": "600",
    "height": "200",
    "naturalWidth": 600,
    "naturalHeight": 200,
    "image": {
      "contentType": "image/jpeg",
